/uploads/
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/images/
backend/uploads/images/*
!backend/uploads/images/.gitkeep
!backend/uploads/annotated/
backend/uploads/annotated/*
!backend/uploads/annotated/.gitkeep
*.tmp
*.log

