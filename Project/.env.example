# AgriVision AI — Environment Configuration Template
# Copy this file to `.env` and adjust the variables for your local setup.

# Server Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI Model Configuration
# Relative or absolute path to the fine-tuned YOLO pest detection checkpoint (.pt)
MODEL_PATH=models/best.pt
DEFAULT_CONFIDENCE_THRESHOLD=0.35
IMAGE_MIN_AREA_RATIO=0.001

# Storage
UPLOAD_STORAGE_DIR=./uploads

# Authentication & Security
# Change this secret key in production environments
JWT_SECRET=agrivision_jwt_secret_dev_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# MongoDB Atlas Configuration (Optional)
# Leave blank to run in offline local development storage mode (JSON fallback)
# Or provide your MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=agrivision_ai

# Kural AI Agricultural Assistant Configuration
# Provide an OpenAI API key (or compatible API provider) to enable live generative Q&A.
# If omitted, Kural operates in local grounded RAG catalog mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
